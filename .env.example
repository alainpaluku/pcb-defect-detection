# EN: Set these in Space Settings; this file is not loaded automatically.
# FR: Définir ces variables dans Settings ; ce fichier n'est pas chargé automatiquement.
PCB_MODEL_REPO=your-account/pcb-defect-model
PCB_MODEL_FILENAME=pcb_model.pt
PCB_MODEL_REVISION=main
# PCB_MODEL_PATH=models/pcb_model.pt
PCB_DEVICE=cpu
PCB_IMAGE_SIZE=640
PCB_CPU_THREADS=2
PCB_MAX_FILE_MB=20
PCB_MAX_PIXELS=20000000
# EN: For private weights, set HF_TOKEN as a Space secret.
# FR: Pour des poids privés, définir HF_TOKEN comme secret du Space.
